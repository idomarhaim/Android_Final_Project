rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Private per-user data: goals, tasks, progress, friends ──────
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Public leaderboard projection ──────────────────────────────
    // Any signed-in user can read (for the leaderboard); only the owner writes.
    // NOTE: points/level are written by the client for this course project. In
    // production, compute them in a Cloud Function and lock writes down.
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ── Shared achievement feed ────────────────────────────────────
    match /shares/{shareId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;
    }

    // ── Challenges (nice-to-have) ──────────────────────────────────
    // The challenge document itself is owner-only: title, dates and type are
    // the owner's to set. Joining is NOT an edit to it — see participants.
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;

      // One row per participant, id = their uid, writable only by them. This
      // is what makes joining possible without letting a non-owner edit the
      // challenge. A subcollection is not covered by the match above, so
      // without this block these documents match no rule and are denied.
      // Scores are client-written, exactly as publicProfiles.points is above,
      // and carry the same caveat.
      match /participants/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }
    }
  }
}
