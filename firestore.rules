rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if the authenticated user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: validate a waypoint document structure (v0.3 wayfinder map)
    function isValidWaypoint() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'goalId', 'title', 'order', 'status', 'createdAt'])
        && data.userId is string
        && data.goalId is string
        && data.title is string
        && data.order is number
        && data.status in ['LOCKED', 'AVAILABLE', 'IN_PROGRESS', 'COMPLETED']
        && data.title.size() <= 200;
    }

    // Helper: validate a milestone document structure (v0.3 wayfinder map)
    function isValidMilestone() {
      let data = request.resource.data;
      return data.keys().hasAll(['userId', 'goalId', 'title', 'order', 'completed', 'createdAt'])
        && data.userId is string
        && data.goalId is string
        && data.title is string
        && data.order is number
        && data.completed is bool
        && data.title.size() <= 200;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Goals collection
    match /goals/{goalId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Waypoints collection — GoalPilot v0.3 wayfinder map
    // Waypoints are the stops along the path from start to goal completion.
    // Each waypoint belongs to a goal and has an ordered position on the map.
    match /waypoints/{waypointId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidWaypoint();
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Milestones collection — GoalPilot v0.3 wayfinder map
    // Milestones are significant checkpoints on the wayfinder map,
    // representing major achievements toward a goal.
    match /milestones/{milestoneId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidMilestone();
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Recommendations collection (cached LLM results)
    match /recommendations/{recId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}