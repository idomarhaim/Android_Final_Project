rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    /**
     * True when this write touches NONE of `fields` — the file's first field-level
     * condition (`C20` #42, spec 5.2).
     *
     * It takes a LIST rather than one name because §6 (`C14` #23) added two fields that
     * are owned by the same writer for the same reason as the first: `scoreSource` and
     * `reportedAt` on a participant row. A participant who could write their own
     * `scoreSource` could type a number and label it `DERIVED`, which is precisely the
     * claim the label exists to deny — so pinning `score` alone would have left the
     * provenance self-asserted in the one direction that matters.
     *
     * `diff().affectedKeys()` is the whole reason this is expressible: it reports the
     * keys that actually change between the stored document and the one this write
     * would leave behind, so it catches an add, an edit AND a removal, and it works
     * the same whether the client sends a merge or a whole document. Comparing
     * `request.resource.data.field == resource.data.field` instead would error out on
     * a document where the key is absent, which denies for the wrong reason and reads
     * in the logs as a permissions bug.
     *
     * The `resource != null` guard is the same concern one step out. Firestore evaluates
     * BOTH the create and the update clause for a `set()`, so on a document that does not
     * exist yet this function is called with no `resource` at all and `diff()` fails. It
     * denies either way -- an update of a missing document is a create, and the create
     * clause is the one that should answer it -- but an "evaluation error" in the
     * emulator log is indistinguishable from a rule that is actually broken, and this
     * file is where the next person will come looking.
     */
    function serverOwns(fields) {
      return resource != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ── Private per-user data: goals, tasks, progress, friends ──────
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Public leaderboard projection ──────────────────────────────
    // Any signed-in user can read (for the leaderboard). The owner writes their own
    // identity fields; `points` is the server's.
    //
    // This is what `C20` (#42, spec 5.2) changed, and the NOTE that used to sit here
    // -- "points/level are written by the client for this course project" -- is gone
    // because it stopped being true. `points` is the one number on this document that
    // a reader cannot compute for themselves: `users/{uid}/**` is isOwner(uid), so a
    // leaderboard reader can never see the tasks it sums. That is exactly the test
    // 5.2 draws, and this is where it is enforced.
    //
    // `level` is not mentioned because there is no longer such a field. It was a
    // stored function of `points` in THIS document, so every reader of it could
    // already compute it; 5.2 deleted it outright.
    //
    // The projection function reaches this collection through the Admin SDK, which
    // bypasses these rules entirely -- so the server needs no exemption written here,
    // and there is no service-account uid to keep in step with a deployment.
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();

      // Sign-up creates the row with a zero score (AuthRepositoryImpl). Both spellings
      // of zero are accepted on purpose: the Kotlin client can write an integer or a
      // double depending on the field's type, the JS test suite can only ever produce
      // an integer, and a rule that locks a real user out of signing up is not worth
      // the one clause it costs to be certain.
      allow create: if isOwner(uid)
        && (request.resource.data.points == 0 || request.resource.data.points == 0.0);
      allow update: if isOwner(uid) && serverOwns(['points']);
      allow delete: if isOwner(uid);
    }

    // ── Shared achievement feed ────────────────────────────────────
    match /shares/{shareId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;
    }

    // ── Challenge invites ──────────────────────────────────────────
    // Ido, 2026-08-24: "in the version I have on my phone I can create a CHALLENGE but
    // I cannot invite a friend I have in the app to the CHALLENGE". He was right -- there
    // was no invite mechanism at all, and the only route into somebody else's challenge
    // was Discover, which lists every challenge in the database to every signed-in user.
    //
    // WHY THIS IS TOP-LEVEL AND NOT SOMEWHERE TIDIER. An invite names two people, and
    // every tidier home is unreachable BY THIS FILE'S OWN PARTITION:
    //
    //   * `users/{friendUid}/**` is isOwner(friendUid) -- you cannot write into your
    //     friend's space at all, which is the property the rest of the app depends on.
    //   * `challenges/{id}/participants/{friendUid}` is isOwner too -- and a row conjured
    //     for somebody who never joined would put a competitor in the standings who never
    //     agreed to compete.
    //
    // So it takes the one shape this file already has for a document two different users
    // must each reach on their own account: `shares/{shareId}`, one level up.
    //
    // NOT isSignedIn() ON READ, WHICH IS THE ONE THING THAT MAKES THIS DIFFERENT FROM
    // `shares`. A share is published to a feed; an invite names two people and is nobody
    // else's business. Reading `resource.data` is what expresses that -- and it has a
    // consequence the client cannot ignore:
    //
    // ⚠️ A READ RULE THAT INSPECTS `resource.data` CONSTRAINS EVERY QUERY, NOT ONLY EVERY
    // GET. Firestore will not evaluate a query document-by-document; it rejects up front
    // any query it cannot PROVE is inside the rule. So a listener here must always carry
    // `whereEqualTo("toUid", myUid)` or `whereEqualTo("fromUid", myUid)`, and an
    // unconstrained `collection('challengeInvites')` listener fails with PERMISSION_DENIED
    // on the query itself -- with nothing in the message to say the filter was missing.
    // `firestore-tests/rules.test.mjs` asserts both the filtered success and the
    // unfiltered denial, because that is the trap this design buys.
    match /challengeInvites/{inviteId} {
      allow read: if isSignedIn()
        && (resource.data.toUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid);

      // You may only send in your own name, and never to yourself. What this CANNOT
      // check is whether the sender is in the challenge -- a rule sees this document and
      // nothing else -- so `ChallengeRepositoryImpl.inviteToChallenge` does that, and
      // says so in a sentence rather than in a PERMISSION_DENIED. The residual risk is
      // an offer to join a challenge the recipient could already have found in Discover.
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid;

      // Either party may remove it: the invitee accepts or declines, the inviter
      // withdraws. All three leave exactly the same absence behind, which is why there
      // is one verb rather than three.
      allow delete: if isSignedIn()
        && (resource.data.toUid == request.auth.uid
          || resource.data.fromUid == request.auth.uid);

      // An invite is not edited; it is created and consumed. Permitting an update would
      // let a sender repoint a standing offer at a different challenge after the fact,
      // which is the one thing the copied `challengeTitle` caption must not be able to
      // start lying about.
      allow update: if false;
    }

    // ── Challenges (nice-to-have) ──────────────────────────────────
    // The challenge document itself is owner-only: title, dates and the MEASURE are
    // the owner's to set. Joining is NOT an edit to it -- see participants.
    //
    // The measure is one document's worth of `measureKind` + `measureWord` (spec 6,
    // `C7` #14) and it replaced the free-text `metricUnit` whose "points" default is
    // what produced #23.
    //
    // CHANGING IT AFTER A CHALLENGE HAS STARTED NEEDS EVERY PARTICIPANT'S APPROVAL, AND
    // THAT IS NOW BUILT (2026-08-25). The measure is the unit every participant's score is
    // expressed in, so an owner who could edit it alone would silently re-denominate other
    // people's numbers: a leaderboard reading "8200 steps" yesterday and "8200 km" today
    // has not been corrected, it has been falsified.
    //
    // `serverOwns(['measureKind', 'measureWord'])` on update is what enforces it, and it
    // is the file's SECOND field-level condition -- the same shape `publicProfiles.points`
    // and the participant's `score` already use, for the same reason. The owner writes
    // `pendingMeasureKind` / `pendingMeasureWord` / `pendingChangeId` (ordinary owner
    // fields, unpinned); each participant writes `approvedChangeId` on the one document
    // they are permitted to write; and `functions/src/challenges.ts` applies the change
    // through the Admin SDK, which bypasses these rules -- so the live measure has no
    // client writer at all after creation.
    //
    // THE QUORUM IS EVERYONE WHO IS STILL HERE. A participant who leaves has no row to
    // write `approvedChangeId` in, so counting them would let one person walking away
    // freeze the challenge forever. The function reads whatever rows exist when it runs
    // and asks nothing about who used to be there -- and a departure re-triggers it,
    // because the last hold-out leaving is exactly the event that completes agreement.
    //
    // WHILE A CHANGE IS PENDING THE CHALLENGE KEEPS SCORING IN THE OLD UNIT. The pending
    // fields sit beside the live measure, never on top of it, and nothing on the scoring
    // path reads them. A half-approved change must not stop the race.
    //
    // `create` is deliberately NOT pinned: a challenge is born with its measure, and
    // there is nobody yet to ask.
    match /challenges/{challengeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && serverOwns(['measureKind', 'measureWord']);
      allow delete: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid;

      // One row per participant, id = their uid. This is what makes joining
      // possible without letting a non-owner edit the challenge. A subcollection is
      // not covered by the match above, so without this block these documents match
      // no rule and are denied.
      //
      // The row now has writers with different rights (`C20` #42, spec 5.2), which
      // is the one place this ruling genuinely makes the rules harder:
      //
      //   * the participant   -- creates the row, deletes it to leave, edits the identity
      //                          fields on it, and (since 2026-08-25) writes
      //                          `approvedChangeId` -- their vote on a pending measure
      //                          change. NOT the three server fields.
      //
      // `approvedChangeId` is deliberately NOT pinned, and it is the one field here a
      // participant writes that somebody else reads. That is exactly why it lives on THIS
      // document: it is the only one in the whole challenge tree a participant is
      // permitted to write, which is what §6 means by "each participant writes
      // `approvedChangeId` in the one document they are permitted to write". Writing a
      // stale or invented value achieves nothing -- the function compares it against the
      // challenge's own `pendingChangeId`, so consent cannot be replayed onto a later
      // proposal, and the function clears it whenever a change lands.
      //   * the projection    -- owns `score`, `scoreSource`, `reportedAt` and
      //     function             `updatedAt`, and reaches them through the Admin SDK,
      //                          which bypasses these rules.
      //   * the challenge     -- reads only. There is still no "kick a participant";
      //     owner                see the test below for why granting it is expensive.
      //
      // `score` crosses the ownership boundary -- the person who reports it is not
      // the person reading the standings, and the readers cannot see the report fact
      // at `users/{uid}/challengeReports/{challengeId}` that it is projected from.
      // That is 5.2's test, and it is why this field survived when five of the map's
      // seven derived quantities needed no stored writer at all.
      //
      // SPEC 6 (`C14` #23) ADDED THE OTHER TWO, AND THEY ARE NOT DECORATION.
      // `scoreSource` says whether the number was summed from the participant's linked
      // goal or TYPED BY THEM, and `reportedAt` says when it was typed. Ido asked for
      // that on 2026-08-24: on a shared leaderboard a reading and a typed number are not
      // the same claim, and until now they were pixel identical. A participant who could
      // write their own `scoreSource` could type a number and mark it derived -- the
      // label would then assert the one thing it exists to deny -- so it is pinned here
      // beside `score` rather than trusted to the client that benefits from it.
      //
      // What it still is NOT: evidence about the walk. A participant writes their own
      // fact, so `DERIVED` means "this person pointed the challenge at a goal of
      // theirs". Spec 6's own honest residual is that server-owned scoring stops a win
      // being TYPED, not a reading being FORGED. The badge is a label, never an
      // attestation -- `ChallengeParticipant`'s KDoc says so in the same words.
      match /participants/{uid} {
        allow read: if isSignedIn();

        // Joining starts you at zero. See publicProfiles above for why both
        // spellings of zero are accepted.
        allow create: if isOwner(uid)
          && (request.resource.data.score == 0 || request.resource.data.score == 0.0);
        allow update: if isOwner(uid)
          && serverOwns(['score', 'scoreSource', 'reportedAt']);
        allow delete: if isOwner(uid);
      }
    }
  }
}
