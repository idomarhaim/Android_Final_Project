# ── Android / Gradle ──────────────────────────────────────────────
*.iml
.gradle/
/local.properties
.idea/
.DS_Store
# Ignore build/ at any depth (root and every Gradle module, e.g. app/build/)
build/
/captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex

# Keep the Gradle wrapper jar (it is required to build the project)
!gradle/wrapper/gradle-wrapper.jar

# ── Kotlin ────────────────────────────────────────────────────────
.kotlin/

# ── Secrets / credentials (NEVER commit) ──────────────────────────
# Real google-services.json is per-developer; a structurally-valid
# placeholder is committed so the project builds. See docs/SETUP.md.
# Uncomment the next line once you drop in your real file if you do
# NOT want to track it:
# /app/google-services.json
/functions/.env
/functions/.env.*
/functions/node_modules/
*.keystore
!debug.keystore
# The release signing key. Permanent and irreplaceable — back it up off this
# machine (see docs/RELEASING.md); never commit it.
*.jks
service-account*.json

# ── Logs / crash dumps ────────────────────────────────────────────
*.log
hs_err_pid*
replay_pid*

# ── Node (Cloud Functions) ────────────────────────────────────────
node_modules/
functions/lib/
npm-debug.log*

# ── OS / editor cruft ─────────────────────────────────────────────
Thumbs.db
# Machine-local VS Code settings. Holds only
# `java.configuration.updateBuildConfiguration: disabled`, which suits this
# machine's JDK setup and should not be imposed on a fresh clone. `.idea/` above
# is ignored for the same reason.
.vscode/

# ── graphify knowledge graph (wired 2026-08-19) ───────────────────
# Regenerable local cache, never source: the free AST rebuild runs from the
# post-commit hook, and community labels are re-derived on demand
# (`graphify label . --backend=claude-cli`). Placement per JARVIS B11:
# in-tree per project, gitignored there.
/graphify-out/
