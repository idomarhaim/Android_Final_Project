    <string name="gp_widget_effort">מאמץ ותוצאה</string>
    <string name="gp_widget_level">רמה</string>
    <string name="gp_widget_level_large">רמה ונקודות</string>

    <!-- §4.8: `לשעה`, not `ל־`, and `שעה` and not `תאריך` — the argument is
         `asOfShort`, which is DateFormat.getTimeFormat, i.e. a clock reading
         (`14:32`) and never a date. -->
    <string name="gp_widget_as_of">נכון לשעה %1$s</string>

    <string name="gp_widget_never_opened">פתחו את GoalPilot פעם אחת וזה יתמלא</string>
