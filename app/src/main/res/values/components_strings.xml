<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy for ui/components/ — issue #51's literal sweep, the shared package.

  A sibling file to strings.xml, following analytics_strings.xml and
  widget_strings.xml: they merge into one R.string namespace at build time, and
  keeping a package's speech in its own file is what lets two sessions sweep two
  packages without contending on one file. Every key is prefixed components_.

  HebrewLocaleResourceTest pairs files by NAME, so this owes a values-iw/
  counterpart with exactly these keys.

  WHY THIS PACKAGE HOLDS COPY THAT IS NOT ITS OWN

  Most of ui/components/ takes its words as PARAMETERS — EmptyState, LoadingBox,
  DonutChart, StackedColumnChart and SimpleBarChart all receive their labels from
  the screen that renders them, so their Hebrew belongs to the eight callers and
  not here. What is actually shared, and what this file exists for, is the copy
  hanging off two DOMAIN ENUMS that several packages render:

    * GoalCategory — ten labels, rendered by ui/components/GoalCard.kt and by
      three feature packages that are still unswept.
    * AppSkin — two names and two taglines, rendered only by SkinPicker.

  Both were constructor arguments on the enum, which is the fourth idiom in
  kb/dev/untranslatable-idioms.md: a language switch cannot reach a constructor
  argument. The remedy is the split iconForKey already uses — the enum keeps
  IDENTITY, and a UI-side mapper resolves the resource. ComponentStrings.kt is
  that mapper.

  Two things this file is deliberate about:

  1 · NUMBERS ARE PASSED IN PRE-ISOLATED (%1$s, never %1$d) wherever they land
      inside prose. §4.8: a Latin-digit run inside an RTL paragraph is re-ordered
      by the bidi algorithm, so `5/10` renders as `10/5`. The caller wraps the
      whole run with core/util/Bidi.kt and hands over a String. The single
      exception is components_percent, which is nothing BUT a number and is
      isolated as a whole by percentText().

  2 · THE GOAL ENTITY IS יעד, NEVER מטרה (§5.1 / E1). Nothing in the English
      changes; see the values-iw/ counterpart.
-->
<resources>

    <!-- ── GoalCard ────────────────────────────────────────────────
         The meta line was a four-part Kotlin concatenation:
             "${category.label} • ${current}/${target} ${unit}"
         Word order is a property of the language and no resource file can
         reorder a buildString, so it is one whole string with three arguments.

         Reading each argument against the code that fills it, which is the only
         way to know whether it needs isolating (untranslatable-idioms.md §5):
           %1$s  the category label — app speech, resolved from this file.
           %2$s  the current/target ratio, ALREADY ISOLATED by the caller. Two
                 digit runs and a slash: unisolated it renders as `10/5`, which
                 is not a typo but a reversal of the claim.
           %3$s  the unit — USER-AUTHORED CONTENT ("workouts", "hours", and the
                 "%" default). Never translated (§8: content never moves), and
                 isolated because its script is unknown at authorship. -->
    <string name="components_goal_meta">%1$s • %2$s %3$s</string>
    <string name="components_goal_untitled">Untitled goal</string>
    <!-- TalkBack only: the check mark that replaces no visible words. -->
    <string name="components_goal_complete">Goal complete</string>

    <!-- TalkBack only, and the ONLY words the unmeasured marker has.

         Spec 1.3 (C22 #44, #65): the marker is a dashed SQUARE carrying "#",
         with no words and no buttons, because stating a fact asserts nothing
         and may therefore appear wherever the goal is listed. The offer itself
         needs consent and lives only on the goal's own screen.

         A screen reader has no square to see, so this line has to carry both
         halves the shape carries visually: that there is no number YET, and
         that nothing is owed. The prototype's own caption is the source —
         "no number yet. Nothing is owed and nothing is offered here." -->
    <string name="components_goal_unmeasured">No number yet — nothing is owed here</string>

    <!-- ── The row where the percentage used to be (#66) ──────────────
         A goal with no measure printed `0%` and `0/100` beside the marker that
         says it has no number. Spec 1.3 makes absence the DEFAULT, and both
         figures were arithmetic against targetValue's 100.0 fallback — a target
         nobody set — so the row stated two facts it did not have.

         What replaces them is drawn by the design 1.3 links, the C22 prototype
         at docs/prototypes/2026-08-15-measure-proposal: its life-area frame
         renders the unmeasured row as `no number — 11 sessions logged`. The
         count is the one number such a goal genuinely has.

         %1$s is the category label, resolved from this file. %2$s is the count
         phrase below, ALREADY carrying its own pre-isolated digits. -->
    <string name="components_goal_meta_unmeasured">%1$s • no number — %2$s</string>

    <!-- The same row before anything has been logged. Not the plural's zero
         case: `no number — 0 entries logged` states an absence twice and reads
         as a scolding, which is the opposite of 1.3's "nothing is owed". -->
    <string name="components_goal_meta_unlogged">%1$s • no number yet</string>

    <!-- %1$s is a pre-isolated count (rule 1 at the top of this file). -->
    <plurals name="components_goal_entries_logged">
        <item quantity="one">%1$s entry logged</item>
        <item quantity="other">%1$s entries logged</item>
    </plurals>

    <!-- Percentage, as its own string so the sign's placement is the
         translator's call. Letters-free, so the untranslated-copy rule in
         HebrewLocaleResourceTest exempts it by construction. -->
    <string name="components_percent">%1$d%%</string>

    <!-- ── GoalCategory ────────────────────────────────────────────
         The ten labels that were constructor arguments on the enum. The enum
         keeps its `name` and `iconKey`; these are its speech.

         Rendered by GoalCard here and by feature/dashboard, feature/goals'
         AddEditGoalScreen and GoalDetailScreen, which are unswept — those three
         still read GoalCategory.label and switch to localizedLabel() when their
         own sweep lands. The Hebrew is authored once, here, either way. -->
    <string name="components_category_health">Health</string>
    <string name="components_category_fitness">Fitness</string>
    <string name="components_category_sleep">Sleep</string>
    <string name="components_category_nutrition">Nutrition</string>
    <string name="components_category_relationships">Relationships</string>
    <string name="components_category_career">Career</string>
    <string name="components_category_projects">Projects</string>
    <string name="components_category_learning">Learning</string>
    <string name="components_category_finance">Finance</string>
    <string name="components_category_other">Other</string>

    <!-- ── AppSkin ─────────────────────────────────────────────────
         Names and taglines, previously on the enum beside the persisted `id`.
         The id is unchanged and stays the identity, so no stored preference
         moves; only the words did.

         The names ARE translated rather than marked translatable="false". They
         are evocative words, not a brand: "Aurora" and "Blossom" both have
         ordinary Hebrew equivalents, and leaving them in Latin would put a bare
         Latin run in the middle of an otherwise Hebrew list — §4.8's problem,
         for no gain. -->
    <string name="components_skin_aurora">Aurora</string>
    <string name="components_skin_aurora_tagline">Ocean blue &amp; evergreen</string>
    <string name="components_skin_blossom">Blossom</string>
    <string name="components_skin_blossom_tagline">Sunset pink &amp; orange</string>

    <!-- Spec §4.1's four materials. The material is a SURFACE; the skin above it
         is a PALETTE. Names are product nouns, not CSS terms — a user picking a
         look does not need to know what a backdrop filter is. -->
    <string name="components_material_glass">Glass</string>
    <string name="components_material_glass_tagline">Frosted panels, colour showing through</string>
    <string name="components_material_liquid">Liquid glass</string>
    <string name="components_material_liquid_tagline">Glossy, lit along the edge</string>
    <string name="components_material_neo">Soft</string>
    <string name="components_material_neo_tagline">One flat surface, gently raised</string>
    <string name="components_material_darkneo">Soft dark</string>
    <string name="components_material_darkneo_tagline">Charcoal, with one bright accent</string>

    <!-- §4.1's OWN name for each material, carried on the tile so the two
         vocabularies are reachable from one another. The labels above are the
         plain-English words a user reads; these are the words the design of
         record, the issues and the changelogs use, and until #53 they appeared
         nowhere in the UI at all — so a user who had read the spec could not
         find the control, and a session receiving "no dark blue neo" could not
         match the report to a tile. The join now exists in both directions:
         here, and in the mapping table beside §4.1's material table.

         translatable="false" on the four names, and that is a decision rather
         than an omission. Their job is to be the SAME TOKEN as the design of
         record, which is written in English — ניאו would be a Hebrew word
         appearing in no document, which is the failure this fixes rather than
         a translation of it. The frame around them IS translated, and the name
         is bidi-isolated at the call site because its script differs from the
         paragraph's (core/util/Bidi.kt, the same treatment a user-authored
         measure unit gets). Contrast the skin names above, which are deliberately
         translated: those are evocative product words whose job is to read well,
         not designations whose job is to match a document. -->
    <string name="components_material_spec_name">Spec: %1$s</string>
    <string name="components_material_glass_spec" translatable="false">Glassmorphism</string>
    <string name="components_material_liquid_spec" translatable="false">Liquid glass</string>
    <string name="components_material_neo_spec" translatable="false">Neo</string>
    <string name="components_material_darkneo_spec" translatable="false">Dark neo</string>

    <!-- §4.1: a material may declare itself brightness-locked, and the picker has
         to SAY so. This is that word, on the tile itself. -->
    <string name="components_material_dark_only">Dark only</string>

    <!-- ══════════════════════════════════════════════════════════════════
         C19 · the success/failure run — spec 4.7, #64.

         > A failure is a missed WINDOW and nothing else; a goal with nothing
         > due is missing a STEP, not failing.

         Every string here is one of that section's own sentences, and two of
         them are load-bearing rather than decorative:

         * components_run_window_is answers the ticket's headline question ON
           THE SCREEN. 4.7: "The numbers are meaningless without it, so it is
           not spec-only text." It is not a caption to be trimmed.
         * components_run_asymmetry lives BESIDE THE TIME DONUT and nowhere
           else. Revision 1 of the prototype printed it on every area frame,
           which said the same thing twice and never where the two numbers
           actually meet.

         There is deliberately NO string here for a rate, a percentage or a
         streak: 4.7 refuses the single "success rate" that C3 and C5 both
         refused, and a resource is how one would sneak back in as a subtitle.
         ══════════════════════════════════════════════════════════════════ -->
    <string name="components_run_title">Window by window</string>
    <string name="components_run_range_30_days">30 days</string>
    <string name="components_run_range_8_weeks">8 weeks</string>
    <string name="components_run_range_6_months">6 months</string>

    <!-- The pair. Two numbers, never a rate. -->
    <string name="components_run_kept">kept</string>
    <string name="components_run_missed">missed</string>

    <!-- The legend. "still owed - not a failure" carries its own disclaimer
         because 2.3 is explicit that OVERDUE is not one, and the material note
         calls it "the one state that must NOT read as a failure". -->
    <string name="components_run_legend_kept">kept</string>
    <string name="components_run_legend_missed">missed</string>
    <string name="components_run_legend_owed">still owed — not a failure</string>
    <string name="components_run_legend_nothing_due">nothing due</string>
    <string name="components_run_window_is">a window counts as kept when everything due in it was done</string>

    <!-- C17's asymmetry, stated where the divided number and the undivided one
         meet. Analytics only. -->
    <string name="components_run_asymmetry">A task serving two areas is a success in full in both. Only its minutes are divided — that asymmetry is deliberate.</string>

    <!-- Nothing has ever been due here. Said in words rather than drawn as a
         row of empty dots over "0 kept · 0 missed", which reads as a verdict. -->
    <string name="components_run_empty_title">Nothing has been due here yet</string>
    <string name="components_run_empty_subtitle">Give something in this area a date and this becomes the record of it — window by window, kept or missed.</string>

    <!-- 4.7's table. NOT a dormancy state: "Asleep · invisible · failed were
         three labels for C10's already-decided theme axis." The row names the
         step that is missing and offers that step. -->
    <string name="components_run_no_next_step">no next step</string>
    <plurals name="components_run_no_next_step_footer">
        <item quantity="one">%1$s goal here has no next step — nothing is owed there, so nothing can be missed.</item>
        <item quantity="other">%1$s goals here have no next step — nothing is owed there, so nothing can be missed.</item>
    </plurals>
    <string name="components_run_offer_break_down">Break it into steps</string>
    <string name="components_run_offer_schedule">Schedule the first one</string>

    <!-- 4.7's third offer, wired by #67. It is a COMMAND: the app never suggests
         a goal is over (C4), and the row's own label says 'no next step', which is
         about what is scheduled rather than about whether the goal matters. -->
    <string name="components_run_let_it_go">Let it go</string>

    <!-- "idle 4 months". The unit is chosen by size so the sentence stays
         readable; null idle prints nothing at all, because "idle 0 days" would
         claim activity that never happened. -->
    <plurals name="components_run_idle_days">
        <item quantity="one">idle %1$s day</item>
        <item quantity="other">idle %1$s days</item>
    </plurals>
    <plurals name="components_run_idle_weeks">
        <item quantity="one">idle %1$s week</item>
        <item quantity="other">idle %1$s weeks</item>
    </plurals>
    <plurals name="components_run_idle_months">
        <item quantity="one">idle %1$s month</item>
        <item quantity="other">idle %1$s months</item>
    </plurals>

    <!-- A screen reader has no dot to look at, so each window says which of the
         four it is and when it was. Same duty UnmeasuredMarker's one string
         discharges for a component that is otherwise silent. -->
    <string name="components_run_window_kept">Kept, %1$s</string>
    <string name="components_run_window_missed">Missed, %1$s</string>
    <string name="components_run_window_owed">Still owed, %1$s</string>
    <string name="components_run_window_nothing_due">Nothing due, %1$s</string>

    <!-- #67's confirm. Deletion is irreversible and there is no undo, so this
         dialog is the one moment the app has to say what is about to happen.
         Two questions, deliberately separate: what goes, and what stays. -->
    <string name="components_delete_title">Delete “%1$s”?</string>
    <string name="components_delete_untitled">Untitled</string>
    <string name="components_delete_goes">WHAT GOES</string>
    <string name="components_delete_stays">WHAT STAYS</string>
    <string name="components_delete_irreversible">This cannot be undone.</string>
    <string name="components_delete_confirm">Delete</string>
    <string name="components_delete_cancel">Cancel</string>

    <!-- The subject line of each block names what the thing IS rather than
         repeating its title, which is already in the heading above it. -->
    <string name="components_delete_goal_itself">This goal, and its measure.</string>
    <string name="components_delete_task_itself">This task.</string>
    <string name="components_delete_area_itself">This life area.</string>

    <!-- A goal takes its progress log with it and leaves its tasks standing —
         §1.1's lossless demotion, "the task underneath is real work he typed in". -->
    <plurals name="components_delete_goal_entries">
        <item quantity="one">%1$s entry in its progress log.</item>
        <item quantity="other">%1$s entries in its progress log.</item>
    </plurals>
    <plurals name="components_delete_goal_tasks_kept">
        <item quantity="one">%1$s task, which stays and becomes unfiled.</item>
        <item quantity="other">%1$s tasks, which stay and become unfiled.</item>
    </plurals>

    <!-- A task is the only one of the three whose deletion reaches history, so
         the windows that already happened are counted separately from the ones
         still to come (§2.3). -->
    <plurals name="components_delete_task_occurrences">
        <item quantity="one">%1$s scheduled occurrence.</item>
        <item quantity="other">%1$s scheduled occurrences.</item>
    </plurals>
    <plurals name="components_delete_task_settled">
        <item quantity="one">Including %1$s that already happened.</item>
        <item quantity="other">Including %1$s that already happened.</item>
    </plurals>
    <plurals name="components_delete_task_points">
        <item quantity="one">The %1$s point it earned.</item>
        <item quantity="other">The %1$s points it earned.</item>
    </plurals>

    <!-- An area's goals are kept and unfiled, which is what deleteLifeArea has
         always done. This says so BEFORE the act rather than after it. -->
    <plurals name="components_delete_area_goals_kept">
        <item quantity="one">%1$s goal, which stays and becomes unfiled.</item>
        <item quantity="other">%1$s goals, which stay and become unfiled.</item>
    </plurals>

</resources>
