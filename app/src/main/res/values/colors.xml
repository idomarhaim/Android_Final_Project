<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      These two exist only for the *window* — the frame Android draws before
      Compose has its first frame up. gp_window_background must track the default
      skin's (Aurora) `background` token in ui/theme/Color.kt exactly, or cold
      start flashes a colour the app never uses again. Everything else is themed
      in Compose.
    -->
    <color name="ic_launcher_background">#0A56C4</color>
    <color name="gp_window_background">#D0E2F5</color>
</resources>
