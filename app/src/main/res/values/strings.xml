<resources>
    <!--
      The brand, not a word: "GoalPilot" is what the product is called in every
      language, and translating it would make the launcher icon disagree with
      everything Ido calls it. `translatable="false"` is aapt's own way to say
      so, and it is what excuses this key from #51's Hebrew parity check.
    -->
    <string name="app_name" translatable="false">GoalPilot</string>
    <string name="app_tagline">Pilot your life goals</string>

    <!--
      Google Tasks consent (issue #36, spec §2.6 / §0.4).

      A declined scope has to read as *declined*. The generic "grant permission"
      prompt made a first-ever run and a deliberately unticked box identical, and
      §0.4 says to speak about a failure the user can act on — leaving a checkbox
      unticked is exactly that.

      The wording names the box rather than asserting the user unticked it: an
      account that predates the scope was never shown it, and the remedy is the
      same either way.
    -->
    <string name="tasks_consent_missing_title">Google Tasks access was not granted</string>
    <string name="tasks_consent_missing_body">Google shows &#8220;View your tasks&#8221; unticked on its consent screen, so signing in can succeed while granting nothing. Grant it below and GoalPilot can read your tasks.</string>
    <string name="tasks_consent_grant_action">Grant Google Tasks access</string>

    <!--
      Device settings (spec §4.9 / §5.1). #48 moved them off Profile onto the
      Settings surface §4.9 specifies; they are resolved from feature/settings/.
    -->
    <string name="settings_appearance_title">Appearance</string>

    <!-- The Google Tasks import and the Health Connect sync, which moved here
         from the home screen on 2026-08-24 at Ido's request. "Connected apps"
         rather than "Sync": what the user is deciding is which other
         applications this phone lets GoalPilot read, and a sync is what
         follows from that rather than the thing being chosen. -->
    <string name="settings_connected_title">Connected apps</string>
    <string name="settings_appearance_description">Pick the colour theme for the whole app.</string>

    <string name="settings_language_title">Language</string>
    <!--
      Names the content boundary on the screen rather than in a doc: §5.1's
      discriminator is speech vs content, and a user who expects a switch to
      rewrite their own goals into Hebrew has been misled by our silence.
    -->
    <string name="settings_language_description">Choose the language GoalPilot speaks. Your own goals, tasks and life areas stay exactly as you wrote them.</string>
    <string name="settings_language_system">System default</string>

    <!--
      C13's AI section (#54, decided in #32). Section title and description are
      resources like Appearance's and Language's; the card's own sentences are
      literals like every other card in feature/settings/, which #51's literal
      sweep has not reached (AnalyticsLiteralSweepTest.SWEPT_PACKAGES).
    -->
    <string name="settings_ai_title">AI</string>
    <string name="settings_ai_description">GoalPilot answers with its own free model. You can add your own API key instead — it stays on this phone, encrypted, and is never saved to your account.</string>

    <!--
      Notification channels (#8, spec §2.5). Channel names and descriptions are
      rendered by the SYSTEM, on a settings screen this app never draws, so they
      are the one class of user-facing text that must live in res/ even when the
      code that posts through them is unswept: nothing else can supply them at
      the moment Android asks.

      Two channels, not one, because the system's own control is per channel and
      these two are things a person genuinely wants separately. Silencing "did
      the app understand where this goes?" must not also silence tonight's
      planning prompt.
    -->
    <string name="gp_channel_filing_name">Smart filing</string>
    <string name="gp_channel_filing_description">When a task you added quickly did not fit any goal you already have.</string>
    <string name="gp_channel_reminders_name">Reminders and planning</string>
    <string name="gp_channel_reminders_description">Task reminders, and the nightly prompt to plan tomorrow.</string>

    <!--
      #8's notification bodies. The filing titles mirror DashboardScreen's
      SmartAddReceipt.sentence() deliberately: one event, two surfaces, and a
      notification that phrased it differently would read as a second thing
      having happened.
    -->
    <string name="gp_notif_filing_new_goal_title">No goal fitted</string>
    <string name="gp_notif_filing_new_goal_body">Suggested a new goal, &#8220;%1$s&#8221;, for &#8220;%2$s&#8221;. Tap to keep it or drop it.</string>
    <string name="gp_notif_filing_no_goal_title">Added without a goal</string>
    <string name="gp_notif_filing_no_goal_body">&#8220;%1$s&#8221; is in your tasks, but no goal fits it yet.</string>

    <string name="gp_notif_plan_tomorrow_title">Plan tomorrow</string>
    <string name="gp_notif_plan_tomorrow_body">A few minutes now saves the morning. Tap to look at what is open.</string>

    <!-- §2.5 occurrence reminders (#56). One per rung; the deadline's says why it moved. -->
    <string name="gp_notif_reminder_deadline_tonight">Due at %1$s and it takes about %2$s — worth starting tonight.</string>
    <string name="gp_notif_reminder_deadline_now">Due at %1$s and it takes about %2$s — worth starting now.</string>
    <string name="gp_notif_reminder_all_day">An all-day task for today.</string>
    <string name="gp_notif_reminder_block">Your slot runs %1$s to %2$s.</string>
    <string name="gp_notif_reminder_span">Your window is open, through %1$s.</string>
</resources>
