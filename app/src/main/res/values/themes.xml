<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The Activity window theme only needs a background + no action bar; all
      real theming (Material 3 color scheme, dark mode, dynamic color) is done
      in Compose (see ui/theme/Theme.kt). Parenting on the framework Material
      theme avoids a dependency on the Material Components (Views) library.
    -->
    <style name="Theme.GoalPilot" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/gp_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
