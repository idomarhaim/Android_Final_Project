<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Health Connect (spec §5, §6 nice-to-have). Read-only: GoalPilot never writes
      back, so no WRITE_* permission is declared and the user is never asked for one.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!--
      Package visibility for Health Connect. On Android 13 and below the provider is
      a separate app, and without this <queries> entry Android 11+ package filtering
      hides it — getSdkStatus() then reports SDK_UNAVAILABLE on a device that has it
      installed. Redundant on 14+, where the provider is part of the system.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name=".GoalPilotApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoalPilot">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GoalPilot"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Health Connect refuses to grant health permissions to an app that cannot
          explain itself. It launches this screen from its own settings, so the
          activity is exported and lives outside the main nav graph.
        -->
        <activity
            android:name=".feature.health.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.GoalPilot">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          Android 14+ moved the same rationale behind VIEW_PERMISSION_USAGE. It has
          to be an <activity-alias> rather than a second <intent-filter>: the system
          requires the START_VIEW_PERMISSION_USAGE permission on the component it
          launches, and putting that on the activity itself would also gate the 13-
          and-below entry point above, which is not allowed to be gated.
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".feature.health.HealthPermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
