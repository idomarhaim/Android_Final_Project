<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Notifications (#8, spec §2.5 / R5). Runtime-requested from API 33; below
      that the declaration alone is the grant.

      NOT asked at launch. NotificationPermissionPolicy raises the dialog at the
      first filing outcome that speaks — from Android 13 the system stops
      showing the dialog after two dismissals, so the first ask is very nearly
      the only ask, and a cold-launch prompt spends it before the user has seen
      the app do anything.

      No SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM, deliberately: nothing scheduled
      here needs the minute, and USE_EXACT_ALARM asserts to Play that this is an
      alarm-clock app. See notifications/ReminderScheduler.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Health Connect (spec §5, §6 nice-to-have). Read-only: GoalPilot never writes
      back, so no WRITE_* permission is declared and the user is never asked for one.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!--
      Package visibility for Health Connect. On Android 13 and below the provider is
      a separate app, and without this <queries> entry Android 11+ package filtering
      hides it — getSdkStatus() then reports SDK_UNAVAILABLE on a device that has it
      installed. Redundant on 14+, where the provider is part of the system.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name=".GoalPilotApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoalPilot">

        <!--
          singleTop for #8's notification tap-through: a tap on a second
          notification while the app is already open must move the running
          instance, not stack a fresh copy of it on top of itself. It arrives
          through onNewIntent, which is why MainActivity handles both that and
          onCreate (NotificationDeepLink.offer).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.GoalPilot"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Health Connect refuses to grant health permissions to an app that cannot
          explain itself. It launches this screen from its own settings, so the
          activity is exported and lives outside the main nav graph.
        -->
        <activity
            android:name=".feature.health.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.GoalPilot">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          Android 14+ moved the same rationale behind VIEW_PERMISSION_USAGE. It has
          to be an <activity-alias> rather than a second <intent-filter>: the system
          requires the START_VIEW_PERMISSION_USAGE permission on the component it
          launches, and putting that on the activity itself would also gate the 13-
          and-below entry point above, which is not allowed to be gated.
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".feature.health.HealthPermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          The widget pack (spec §4.5). One <receiver> per tile, because the
          launcher's widget picker lists receivers — so five entries with five
          descriptions is what the user chooses from, rather than one entry and a
          configuration screen standing between "show me my week" and seeing it.

          Every one is exported: the component is launched by the *launcher*,
          which is a different app, so android:exported="false" would make the
          tile un-placeable with no error the user could act on.

          APPWIDGET_UPDATE is the only action declared. Glance's own receiver
          handles the rest of the AppWidgetProvider protocol (options changed,
          deleted, enabled) through the base class, and re-declaring them here
          would mean two places to keep in step.
        -->
        <receiver
            android:name=".ui.widget.GoalsWidgetReceiver"
            android:exported="true"
            android:label="@string/gp_widget_goals">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_goals_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.WeekWidgetReceiver"
            android:exported="true"
            android:label="@string/gp_widget_week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_week_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.TrendWidgetReceiver"
            android:exported="true"
            android:label="@string/gp_widget_trend">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_trend_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.EffortWidgetReceiver"
            android:exported="true"
            android:label="@string/gp_widget_effort">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_effort_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.LevelWidgetReceiver"
            android:exported="true"
            android:label="@string/gp_widget_level">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_level_info" />
        </receiver>

    </application>

</manifest>
