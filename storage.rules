rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images are stored under "<folder>/<uid>/<uuid>.jpg".
    // Any signed-in user may read (so friends can see shared images);
    // only the owner may upload, and only images under 10 MB.
    match /{folder}/{uid}/{fileName=**} {
      allow read: if request.auth != null;

      // Deliberately create+update rather than `write`. `write` also covers
      // delete, and on a delete there is no incoming object, so
      // `request.resource` is null: the two guards below then raise
      // "Null value error" and the rule denies -- including to the owner,
      // deleting their own file. Proven, not assumed: the storage tests in
      // firestore-tests/rules.test.mjs fail against the previous single
      // `allow write` clause and pass against this one.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Deleting is the owner's, with no conditions on an object that isn't
      // being sent. Needed by SocialRepositoryImpl.deleteShare (issue #5),
      // which deletes a post's photo after the post itself -- without this,
      // every shared image ever uploaded outlives the share forever.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
