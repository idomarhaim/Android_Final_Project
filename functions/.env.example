# Copy this file to functions/.env and fill in your real GROQ key.
# functions/.env is git-ignored. GROQ free keys: https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_with_your_groq_key

# Optional overrides. llama-3.1-8b-instant was deprecated by GROQ on 2026-06-17
# and shuts down 2026-08-16 — do not pin it. See console.groq.com/docs/deprecations.
GROQ_MODEL=openai/gpt-oss-20b
